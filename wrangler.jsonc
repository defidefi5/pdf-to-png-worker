{
  "name": "pdf-to-png-worker",
  "compatibility_date": "2025-05-02",
  "main": "src/index.ts",
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "temp-pdf-to-png-worker"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  },
  "observability": {
    "enabled": true
  }
}
